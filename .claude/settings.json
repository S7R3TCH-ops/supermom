{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$f='C:\\Users\\Joel\\.claude\\sm-wrap-done.flag'; if(Test-Path $f){$p=(Get-Process -Id $PID).Parent; if($p -and $p.Name -match '^(node|claude)$'){Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue}}; exit 0",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git -C 'C:/Projects/supermom' push 2>&1; exit 0",
            "if": "Bash(git commit *)",
            "shell": "powershell",
            "statusMessage": "Pushing commits to remote...",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$d='C:\\Users\\Joel\\.claude'; $t=(Get-Date -f yyyyMMdd); $f=\"$d\\sm-pulled-$t.flag\"; if(!(Test-Path $f)){Write-Host 'Pulling latest from remote...'; git -C 'C:/Projects/supermom' pull --ff-only 2>&1|Out-Host; New-Item $f -ItemType File -Force|Out-Null; Get-ChildItem \"$d\\sm-pulled-*.flag\"|Where-Object {$_.Name -ne \"sm-pulled-$t.flag\"}|Remove-Item -Force -ErrorAction SilentlyContinue}; exit 0",
            "shell": "powershell",
            "statusMessage": "Checking for remote updates...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
